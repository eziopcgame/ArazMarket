<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArazMarket</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Araz Market</ApplicationTitle>
    <ApplicationId>ir.arazmarket.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- پشتیبانی از اندروید 5 (API 21) به بالا -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- 📱 معماری‌های پشتیبانی‌شده (برای ساخت دو APK جداگانه) -->
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>

    <!-- ================= تنظیمات فشرده‌سازی و کاهش حجم ================= -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode> <!-- فعلاً partial برای امنیت؛ بعداً می‌توانی full کنی -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidEnableResourceShrinking>true</AndroidEnableResourceShrinking>
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    
    <!-- بهینه‌سازی‌های اضافی -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <!-- معرفی دستی فایل‌های C# -->
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- آیکون برنامه -->
    <MauiIcon Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" />
    
    <!-- اسپلش اسکرین -->
    <MauiSplashScreen Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" BaseSize="128,128" />
    
    <!-- منابع HTML و کتابخانه‌ها -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
