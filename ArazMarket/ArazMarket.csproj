<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArazMarket</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- تنظیمات اسم و نسخه برنامه -->
    <ApplicationTitle>آراز مارکت</ApplicationTitle>
    <ApplicationId>ir.arazmarket.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 🔴 این خط برای پشتیبانی از اندروید 5 (API 21) به بالا تنظیم شده است -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    
    <!-- تنظیمات ساخت فایل APK -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- این بخش برای رفع هشدارهای نسخه 9 دات‌نت الزامی است -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <!-- تنظیمات منابع و آیکون‌ها -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0B3D91" />
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#0B3D91" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
