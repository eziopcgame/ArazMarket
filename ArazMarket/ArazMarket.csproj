<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArazMarket</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Araz Market</ApplicationTitle>
    <ApplicationId>ir.arazmarket.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- حداقل نسخه: اندروید 5 (API 21) -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    
    <!-- خروجی APK -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- آیکون برنامه با مسیر جدید -->
    <MauiIcon Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" />
    
    <!-- اسپلش اسکرین با مسیر جدید -->
    <MauiSplashScreen Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" BaseSize="128,128" />
    
    <!-- منابع HTML -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
