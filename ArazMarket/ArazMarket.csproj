<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArazMarket</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Araz Market</ApplicationTitle>
    <ApplicationId>ir.arazmarket.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- حداقل نسخه اندروید 5 (API 21) -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- ================= تنظیمات فشرده‌سازی و کاهش حجم ================= -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidEnableResourceShrinking>true</AndroidEnableResourceShrinking>
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    
    <!-- بهینه‌سازی‌های اضافی برای کاهش بیشتر حجم -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <!-- باید به صورت دستی فایل‌های C# رو به کامپایلر معرفی کنیم چون EnableDefaultCompileItems=false کردیم -->
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" />
    <MauiSplashScreen Include="Resources\Raw\AppIcon\appicon.png" Color="#0647B8" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
