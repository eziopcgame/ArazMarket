<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArazMarket</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- تنظیمات اسم و نسخه برنامه -->
    <ApplicationTitle>آراز مارکت</ApplicationTitle>
    <ApplicationId>ir.arazmarket.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- تنظیمات مخصوص اندروید -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- تنظیمات منابع، آیکون و فایل‌های HTML -->
  <ItemGroup>
    <!-- آیکون برنامه -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0B3D91" />
    
    <!-- اسپلش اسکرین (صفحه‌ای که موقع باز شدن برنامه ظاهر میشه) -->
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#0B3D91" BaseSize="128,128" />
    
    <!-- فایل‌های HTML و منابع داخلی (برای لود کردن index.html) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
